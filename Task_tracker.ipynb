      "cell_type": "code",
      "source": [
        "import json\n",
        "from datetime import date\n",
        "import matplotlib.pyplot as plt\n",
        "#Empty Dictionary as our diary\n",
        "tracker = {}\n",
        "#To Get today's date\n",
        "today = date.today().isoformat()\n",
        "#To create a page for today in tha diary\n",
        "tracker[today] = {}\n",
        "# To Take tasks from user\n",
        "n = int(input(\"How many tasks did you plan today? \"))\n",
        "if n == 0:\n",
        "  print(\"No task planned today\")\n",
        "else:\n",
        "    for i in range (n):\n",
        "             task = input(\"Enter the task name:\")\n",
        "             status = input(\"Is it Completed? (y/n)\")\n",
        "             if status == 'y':\n",
        "                tracker[today][task]=1\n",
        "             elif status == 'n':\n",
        "                tracker[today][task]=0\n",
        "             else:\n",
        "                print(\"Invalid Input\")\n",
        "print(tracker[today])\n",
        "choice = input(\"Do you want to delete any task:(y/n)\")\n",
        "if choice =='y':\n",
        "  task_to_delete = input(\"Enter the task name to delete:\")\n",
        "  if task_to_delete in tracker[today]:\n",
        "    del tracker[today][task_to_delete]\n",
        "    print(\"Task deleted successfully\")\n",
        "  else:\n",
        "    print(\"Task not found\")\n",
        "# To show today's Task\n",
        "print(\"\\nToday Tasks \")\n",
        "if len(tracker[today])==0:\n",
        "  print(\"No task planned today\")\n",
        "else:\n",
        "   print(tracker[today])\n",
        "   #To Calculate Today's Consistency\n",
        "total_tasks = len(tracker[today])\n",
        "completed_tasks = sum(tracker[today].values())\n",
        "if total_tasks != 0:\n",
        "   today_consistency = (completed_tasks/total_tasks)*100\n",
        "else:\n",
        "    today_consistency = 0\n",
        "print(f'\\nToday Consistency: {today_consistency:.2f}%')\n",
        "#Overall consistency graph\n",
        "dates = []\n",
        "overall_consistency = []\n",
        "for day in tracker:\n",
        "  t = len(tracker[day])\n",
        "  d = sum(tracker[day].values())\n",
        "  percent = (d/t)*100 if t!=0 else 0\n",
        "  dates.append(day)\n",
        "  overall_consistency.append(percent)\n",
        "#To display Graph\n",
        "plt.plot(dates,overall_consistency, marker= 'o')\n",
        "plt.xlabel('Dates')\n",
        "plt.ylabel('Consistency(%)')\n",
        "plt.title('Overall Consistency Tracker')\n",
        "plt.ylim(0,100)\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "with open(\"data.json\",\"w\") as file:\n",
        "  json.dump(tracker,file,indent=4)"
      ],
